{
  "taxonomyVersion": 1,
  "purpose": "A cross-project vocabulary for locating source archives and approved resource packs by literal use, visual language, origin, scope, and readiness. Classify by literal type first; use project affinity as an additional facet when a pack is game-specific.",
  "lifecycleLayers": [
    {
      "id": "source_archive",
      "meaning": "Original licensed upstream package retained for provenance and regeneration. Never imply engine readiness."
    },
    {
      "id": "typed_resource_pack",
      "meaning": "A small, literal-use collection with source lineage, semantic metadata, and an explicit technical/visual review state."
    },
    {
      "id": "engine_reviewed_runtime_asset",
      "meaning": "A named member that has passed the consuming engine's import, scale, material, performance, and visual checks."
    }
  ],
  "provenanceClasses": [
    "borrowed_library",
    "our_build",
    "restricted_external"
  ],
  "authoringStatuses": [
    "upstream_cc0",
    "library_derivative",
    "library_authored",
    "project_adapter"
  ],
  "domains": [
    {
      "id": "environment-natural",
      "groups": ["geology", "terrain", "flora", "water", "weather", "biomes"]
    },
    {
      "id": "environment-built",
      "groups": ["fantasy", "historic", "maritime", "modern", "industrial", "urban", "suburban", "sci-fi", "interior"]
    },
    {
      "id": "objects-and-gear",
      "groups": ["furniture", "props", "weapons", "armor", "tools", "vehicles", "watercraft"]
    },
    {
      "id": "rendering-foundation",
      "groups": ["materials", "decals", "lighting", "sky", "vfx", "audio"]
    },
    {
      "id": "character-support",
      "groups": ["rigs", "animation-tests", "silhouette-references", "clothing-modules", "character-bases", "portraits"]
    }
  ],
  "requiredResourcePackTags": [
    "physicalType",
    "literalUse",
    "styleTags",
    "originKind",
    "authoringStatus",
    "sourceLineage",
    "technicalReviewState",
    "visualReviewState",
    "engineEligibility"
  ],
  "scopeFacets": {
    "contentScope": ["shared", "project_specific", "reference_only"],
    "projectAffinityExamples": ["project-42-pirate-island-rpg", "dr-companion"],
    "subjectScope": ["neutral", "character", "named_character", "setting_specific"],
    "adultPresentation": ["not_applicable", "adult_only"]
  },
  "queryExamples": [
    "physicalType=geology AND styleTags contains basalt",
    "literalUse=street-road AND styleTags contains modern",
    "physicalType=watercraft AND originKind=upstream_cc0",
    "domain=rendering-foundation AND technicalReviewState=passed"
  ]
}
